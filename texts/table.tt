.paper-form {
  gap: 10px;
  margin-top: 35px;

  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 0 1rem;
  background-color: red;

  input,
  select {
    padding: 10px;
    border-radius: 8px;
    border: 1px solid $border;
    outline: none;

    &:focus {
      border-color: $color-content;
    }
  }

  button {
    background: $black-color;
    color: $color-white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;

    &:hover {
      background: rgba($black-color, 0.9);
    }
  }
}